# ============================================================
# 全局 .gitignore（企业知识库问答系统）
# client 目录另有 Vite 默认的 .gitignore（node_modules/dist 等）
# ============================================================

# ---------------- Python 后端 ----------------
# 虚拟环境
server/.venv/
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---------------- 敏感配置（含数据库密码，禁止提交）----------------
server/.env
.env

# ---------------- 运行时数据（均可重新生成，不入库）----------------
# Chroma 向量库（上传文档后自动重建）
server/chroma_db/
# 用户上传的物理文件（测试文档原件在项目根目录的「测试文档」中保留）
server/uploads/

# ---------------- IDE / 编辑器 ----------------
server/.idea/
.idea/
.vscode/
# Trae 编辑器内部文件
.trae/
*.swp

# ---------------- 私人复习资料（不入库）----------------
企业知识库智能问答系统-面试问答清单.md

# ---------------- 操作系统 / 日志 ----------------
.DS_Store
Thumbs.db
*.log
