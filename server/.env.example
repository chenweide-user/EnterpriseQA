# ============================================
# 后端环境配置模板
# 使用方法：复制本文件为 .env，再按本机实际情况填写
#   PowerShell:  Copy-Item .env.example .env
# ============================================

# --- MySQL 数据库配置 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 请填写你本机 MySQL 的真实密码
DB_PASSWORD=你的数据库密码
DB_NAME=db_enterprise_qa

# --- JWT 登录令牌配置（可自行修改为随机字符串）---
JWT_SECRET_KEY=enterprise-qa-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- 阿里云百炼配置 ---
# DASHSCOPE_API_KEY 建议配置为系统环境变量，不要写进本文件
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding

# --- RAG 检索参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=4
SCORE_THRESHOLD=1.0
